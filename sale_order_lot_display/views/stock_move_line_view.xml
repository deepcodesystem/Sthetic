<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_move_line_pivot_inherit_lot_order"
            model="ir.ui.view">
        <field name="name">stock.move.line.pivot.inherit.lot.order</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_pivot"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//pivot" position="inside">
                    <field name="lot_id" type="row"/>
                    <field name="sale_order_id" type="col"/>
                </xpath>
            </data>
        </field>
    </record>

    <record id="stock_move_line_view_search_inherit_lot_order"
            model="ir.ui.view">
        <field name="name">stock.move.line.search.inherit.lot.order</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='lot_id']" position="after">
                    <field name="sale_order_id"/>
                </xpath>
                <xpath expr="//group[@name='groupby']" position="inside">
                    <filter string="Lot" name="group_by_lot"
                            context="{'group_by': 'lot_id'}"/>
                    <filter string="Sale Order" name="group_by_sale_order"
                            context="{'group_by': 'sale_order_id'}"/>
                </xpath>
            </data>
        </field>
    </record>

    <record id="view_move_line_tree_inherit_lot_order"
            model="ir.ui.view">
        <field name="name">stock.move.line.tree.inherit.lot.order</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_move_line_tree"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='lot_id']" position="after">
                    <field name="sale_order_id" optional="show"/>
                </xpath>
            </data>
        </field>
    </record>

</odoo>
