<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_type_form_inherit_return_sequence" model="ir.ui.view">
        <field name="name">stock.picking.type.form.inherit.return.sequence</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='return_picking_type_id']" position="after">
                <field name="use_return_sequence" invisible="code != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>
