<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_delivered">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="doc" t-value="o.with_context(lang=o.partner_id.lang)"/>
                    <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/>

                    <t t-set="address">
                        <div t-field="doc.partner_id"
                            t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                        <p t-if="doc.partner_id.vat">
                            <t t-if="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                            <t t-else="">Tax ID</t>: <span t-field="doc.partner_id.vat"/>
                        </p>
                    </t>

                    <t t-if="doc.partner_shipping_id == doc.partner_invoice_id and doc.partner_invoice_id != doc.partner_id or doc.partner_shipping_id != doc.partner_invoice_id">
                        <t t-set="information_block">
                            <strong>
                                <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">Invoicing and Shipping Address</t>
                                <t t-else="">Invoicing Address</t>
                            </strong>
                            <div t-field="doc.partner_invoice_id"
                                t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                            <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                                <strong class="d-block mt-3">Shipping Address</strong>
                                <div t-field="doc.partner_shipping_id"
                                    t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                            </t>
                        </t>
                    </t>

                    <div class="page">
                        <div class="oe_structure"/>

                        <t t-set="layout_document_title">
                            <span>Bon de commande (Qté livrée) # </span>
                            <span t-field="doc.name"/>
                        </t>

                        <div class="row mb-4" id="informations">
                            <div t-if="doc.client_order_ref" class="col" name="informations_reference">
                                <strong>Your Reference</strong>
                                <div t-field="doc.client_order_ref"/>
                            </div>
                            <div t-if="doc.date_order" class="col" name="informations_date">
                                <strong>Order Date</strong>
                                <div t-field="doc.date_order" t-options='{"widget": "date"}'/>
                            </div>
                            <div t-if="doc.user_id.name" class="col">
                                <strong>Salesperson</strong>
                                <div t-field="doc.user_id"/>
                            </div>
                        </div>

                        <p class="text-muted mb-4">
                            Ce document reflète les quantités effectivement livrées à ce jour
                            (après retour éventuel de marchandise) et non les quantités
                            initialement commandées sur le devis.
                        </p>

                        <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
                        <t t-set="display_discount" t-value="any(l.discount > 0 for l in lines_to_report)"/>
                        <t t-set="display_lots" t-value="any(line.lot_ids_display for line in lines_to_report)"/>

                        <div class="oe_structure"/>
                        <table class="o_has_total_table table o_main_table table-borderless">
                            <thead style="display: table-row-group">
                                <tr>
                                    <th name="th_description" class="text-start">Description</th>
                                    <th name="th_lot_serial" class="text-start" t-if="display_lots">Lot / Série / Qté</th>
                                    <th name="th_quantity" class="text-end text-nowrap">Qté livrée</th>
                                    <th name="th_priceunit" class="text-end text-nowrap">Unit Price</th>
                                    <th name="th_discount" t-if="display_discount" class="text-end">Disc.%</th>
                                    <th name="th_taxes" class="text-end">Taxes</th>
                                    <th name="th_subtotal" class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="sale_tbody">
                                <t t-set="lines" t-value="lines_data.get(doc.id, [])"/>
                                <tr t-if="not lines">
                                    <td colspan="99" class="text-center text-muted">
                                        Aucune quantité livrée sur cette commande.
                                    </td>
                                </tr>
                                <tr t-foreach="lines" t-as="lv">
                                    <td name="td_name"><span t-esc="lv['name']"/></td>
                                    <td name="td_lot_serial" class="text-start" t-if="display_lots">
                                        <span t-esc="lv['line'].lot_ids_display"/>
                                    </td>
                                    <td name="td_quantity" class="text-end">
                                        <span t-esc="lv['qty_delivered']" class="text-nowrap" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Price&quot;}"/>
                                        <span t-esc="lv['uom_name']"/>
                                    </td>
                                    <td name="td_priceunit" class="text-end text-nowrap">
                                        <span t-esc="lv['price_unit']"
                                              t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;decimal_precision&quot;: &quot;Product Price&quot;}"/>
                                    </td>
                                    <td t-if="display_discount" class="text-end">
                                        <span t-esc="lv['discount']"/>
                                    </td>
                                    <td name="td_taxes" class="text-end">
                                        <span t-esc="lv['tax_names']"/>
                                    </td>
                                    <td name="td_subtotal" class="text-end o_price_total">
                                        <span t-esc="lv['price_subtotal']"
                                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="clearfix" name="so_total_summary">
                            <div id="total" class="row mt-n3" name="total">
                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                    <table class="o_total_table table table-borderless">
                                        <tr>
                                            <td>Total HT</td>
                                            <td class="text-end">
                                                <span t-esc="totals_data[doc.id]['amount_untaxed']"
                                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Total Taxes</td>
                                            <td class="text-end">
                                                <span t-esc="totals_data[doc.id]['amount_tax']"
                                                      t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Total TTC</strong></td>
                                            <td class="text-end">
                                                <strong>
                                                    <span t-esc="totals_data[doc.id]['amount_total']"
                                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                                </strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="oe_structure"/>
                        <div t-if="not doc.signature or not doc.env.context.get('sale_include_signature')" class="oe_structure"/>
                        <div t-else="" class="mt-4 ml64 mr4" name="signature">
                            <div class="offset-8"><strong>Signature</strong></div>
                            <div class="offset-8">
                                <img t-att-src="image_data_uri(doc.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                            </div>
                            <div class="offset-8 text-center">
                                <span t-field="doc.signed_by"/>
                            </div>
                        </div>
                        <div>
                            <span t-field="doc.note" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="order_note"/>
                            <p t-if="not is_html_empty(doc.payment_term_id.note)">
                                <span t-field="doc.payment_term_id.note"/>
                            </p>
                            <div class="oe_structure"/>
                            <p t-if="doc.fiscal_position_id and not is_html_empty(doc.fiscal_position_id.sudo().note)" id="fiscal_position_remark">
                                <strong>Fiscal Position Remark:</strong>
                                <span t-field="doc.fiscal_position_id.sudo().note"/>
                            </p>
                        </div>
                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
