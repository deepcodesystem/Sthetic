<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_unpaid_bl">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="company" t-value="o.company_id"/>
                    <t t-set="currency" t-value="o.company_id.currency_id"/>
                    <t t-set="lines" t-value="lines_data.get(o.id, [])"/>
                    <t t-set="totals" t-value="totals_data[o.id]"/>
                    <div class="page">
                        <h3 class="mb-1">BL impayés</h3>
                        <p class="text-muted mb-3">
                            <span t-out="o._get_period_label()"/>
                            <t t-if="o.partner_ids"> — Clients :
                                <span t-out="', '.join(o.partner_ids.mapped('display_name'))"/>
                            </t>
                            — <span t-out="len(lines)"/> BL
                        </p>

                        <table class="table table-sm table-bordered" style="font-size: 11px;">
                            <thead style="display: table-row-group">
                                <tr class="table-light">
                                    <th class="text-start">N° BL</th>
                                    <th class="text-center">Date</th>
                                    <th class="text-start">Client</th>
                                    <th class="text-start">Ville</th>
                                    <th class="text-end">Montant TTC</th>
                                    <th class="text-end">Montant payé</th>
                                    <th class="text-end">Reste à payer</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-if="not lines">
                                    <td colspan="7" class="text-center text-muted">Aucun BL impayé.</td>
                                </tr>
                                <tr t-foreach="lines" t-as="line">
                                    <td class="text-nowrap"><span t-out="line['name']"/></td>
                                    <td class="text-center text-nowrap">
                                        <span t-out="line['date']" t-options="{'widget': 'date'}"/>
                                    </td>
                                    <td><span t-out="line['partner']"/></td>
                                    <td><span t-out="line['city']"/></td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="line['amount_total']"
                                              t-options="{'widget': 'monetary', 'display_currency': line['currency']}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="line['amount_paid']"
                                              t-options="{'widget': 'monetary', 'display_currency': line['currency']}"/>
                                    </td>
                                    <td class="text-end text-nowrap fw-bold">
                                        <span t-out="line['amount_residual']"
                                              t-options="{'widget': 'monetary', 'display_currency': line['currency']}"/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="table-light fw-bold">
                                    <td colspan="4" class="text-end">TOTAL</td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="totals['amount_total']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="totals['amount_paid']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <span t-out="totals['amount_residual']"
                                              t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
